SQL_SERVER=YourServerName
SQL_DATABASE=mygarmin
SQL_DRIVER=ODBC Driver 17 for SQL Server
GARMIN_SQLITE_DIR=C:\Users\User\HealthData\DBs
GARMIN_DB_CLI_DIR=C:\Path\To\External\Repo\GarminDB\scripts

# Google Drive Export 
ENABLE_GDRIVE_EXPORT=true
GDRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID
GDRIVE_CREDENTIALS_PATH=export/credentials.json
GDRIVE_TOKEN_PATH=export/token.json